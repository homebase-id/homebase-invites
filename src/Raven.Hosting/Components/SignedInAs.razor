@* Who is signed in: their public photo and name, as their identity shows them to anyone, and the identity under it.
   With no public name, the identity alone *@
<div class="signed-in">
    <img class="avatar" src="@PublicProfiles.ImageUrl(Identity)" alt="" width="48" height="48" loading="lazy"
         referrerpolicy="no-referrer" />
    <p>
        Signed in as <strong>@(Name ?? Identity)</strong>@(Name == null ? "." : "")
        @if (Name != null)
        {
            <span class="identity">@Identity</span>
        }
    </p>
</div>

@code {
    [Parameter, EditorRequired] public string Identity { get; set; } = "";

    /// <summary>The display name on their public card; null when it has none</summary>
    [Parameter] public string? Name { get; set; }
}
