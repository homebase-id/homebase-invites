@* Step 1: the plans for sale, the owner's own marked *@
<SitePage Title="Choose a plan" Step="0" Wide="true">
    <p class="who">
        Signed in as <strong>@Identity</strong>.
        @if (!Plans.Any(p => UpgradePage.SamePlan(p.Id, CurrentPlanId)))
        {
            <text>Your plan is <strong>@CurrentPlanName</strong>.</text>
        }
    </p>

    @if (Plans.Count == 0)
    {
        <p>There are no plans for sale right now.</p>
    }
    else
    {
        <ul class="plans">
            @foreach (var plan in Plans)
            {
                <PlanCard Plan="plan" IsCurrent="UpgradePage.SamePlan(plan.Id, CurrentPlanId)">
                    <Action>
                        <a class="button" href="@UpgradePage.ConfirmUrl(plan.Id)">Choose @plan.Name</a>
                    </Action>
                </PlanCard>
            }
        </ul>
    }
</SitePage>

@code {
    [Parameter] public string Identity { get; set; } = "";
    [Parameter] public string? CurrentPlanId { get; set; }
    [Parameter] public string CurrentPlanName { get; set; } = "";
    [Parameter] public List<Plan> Plans { get; set; } = [];
}
