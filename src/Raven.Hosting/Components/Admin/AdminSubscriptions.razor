@* Every identity's subscription, newest first: its plan, how it came about, until when, its add-ons and whether its
   host has it; and putting an identity on a plan *@
<AdminLayout Admin="Admin" Title="Subscriptions" Section="subscriptions">
    <form method="post" action="@($"{AdminPages.Root}/subscriptions")" class="panel">
        <Csrf Admin="Admin" />
        <h2 class="panel-title">Change an identity's plan</h2>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
            <label class="field">
                Identity
                <input class="input" name="identity" required value="@Value("identity", null)" autocapitalize="none"
                       spellcheck="false" inputmode="url" placeholder="frodo.homebase.id">
            </label>
            <label class="field">
                Plan
                <select class="input" name="planId" required>
                    <option value="">Choose a plan</option>
                    @foreach (var plan in Plans)
                    {
                        <option value="@plan.Id" selected="@(Value("planId", null) == plan.Id)">@plan.Name (@plan.Storage)</option>
                    }
                </select>
            </label>
            <label class="field">
                Why
                <input class="input" name="note" maxlength="200" value="@Value("note", null)" placeholder="support goodwill">
                <span class="field-hint">Shown in its history.</span>
            </label>
            <label class="field">
                Host
                <select class="input" name="host">
                    <option value="">Find it</option>
                    @foreach (var host in Hosts)
                    {
                        <option value="@host" selected="@(Value("host", null) == host)">@host</option>
                    }
                </select>
            </label>
        </div>
        <p class="mt-4 text-xs text-muted">A free subscription with no end. It replaces the one the identity has, which goes to its history; its add-ons stay. The plan is set on its host straight away, or as soon as a host has it.</p>
        <div class="mt-4"><button type="submit" class="btn">Change the plan</button></div>
    </form>

    <section class="panel mt-6">
        <form method="get" action="@($"{AdminPages.Root}/subscriptions")" class="mb-4 flex flex-wrap items-end gap-3">
            <label class="field grow sm:grow-0">
                Identity
                <input class="input sm:w-64" name="q" value="@Query" autocapitalize="none" spellcheck="false" placeholder="search">
            </label>
            @if (State != null)
            {
                <input type="hidden" name="state" value="@State">
            }
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>

        <div class="mb-4 flex flex-wrap gap-2">
            <a href="@Link(null)" class="@Chip(null)">All <span class="opacity-70">@(Counts.GetValueOrDefault("paid") + Counts.GetValueOrDefault("free"))</span></a>
            @foreach (var (state, label) in Filters)
            {
                <a href="@Link(state)" class="@Chip(state)">@label <span class="opacity-70">@Counts.GetValueOrDefault(state)</span></a>
            }
        </div>

        @if (Rows.Count == 0)
        {
            <p class="text-sm text-muted">No subscriptions@(Query != null || State != null ? " match" : " yet").</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Identity</th><th>Plan</th><th>How</th><th>Since</th><th>Until</th><th>Add-ons</th><th>Host</th></tr></thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var row in Rows)
                        {
                            <tr>
                                <td>
                                    <a class="link flex items-center gap-2" href="@AdminPages.SubscriptionUrl(row.Grant.Identity)">
                                        <img src="@PublicProfiles.ImageUrl(row.Grant.Identity)" alt="" width="24" height="24" loading="lazy"
                                             referrerpolicy="no-referrer" class="size-6 shrink-0 rounded-full bg-line object-cover">
                                        @row.Grant.Identity
                                    </a>
                                </td>
                                <td class="whitespace-nowrap">
                                    @row.PlanName
                                    @if (row.Entitlement.QuotaBytes is { } quota)
                                    {
                                        <span class="block text-xs text-muted">@StorageSize.Format(quota)</span>
                                    }
                                </td>
                                <td class="text-xs whitespace-nowrap">@row.How</td>
                                <td class="text-xs whitespace-nowrap text-muted">@AdminForm.Day(row.Grant.CreatedAt)</td>
                                <td class="text-xs whitespace-nowrap"><Until Row="row" /></td>
                                <td class="text-xs">
                                    @foreach (var addOn in row.AddOns)
                                    {
                                        <span class="block whitespace-nowrap">@addOn.Description</span>
                                    }
                                </td>
                                <td><SyncTag Grant="row.Grant" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</AdminLayout>

@code {
    [Parameter, EditorRequired] public AdminContext Admin { get; set; } = null!;
    [Parameter] public List<SubscriptionRow> Rows { get; set; } = [];
    [Parameter] public Dictionary<string, int> Counts { get; set; } = [];
    [Parameter] public List<Plan> Plans { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Hosts { get; set; } = [];
    [Parameter] public string? Query { get; set; }
    [Parameter] public string? State { get; set; }

    /// <summary>A form that was refused, shown as it was sent</summary>
    [Parameter] public IFormCollection? Form { get; set; }

    private static readonly (string State, string Label)[] Filters =
    [
        ("paid", "Paid"), ("free", "Free"), ("expiring", "Expiring"), ("grace", "In grace"),
        ("out-of-sync", "Host not in sync"), ("add-ons", "With add-ons"),
    ];

    private string Value(string name, string? fallback) => AdminForm.Value(Form, name, fallback);

    private string Link(string? state)
    {
        var query = new List<string>();
        if (Query != null) query.Add($"q={Uri.EscapeDataString(Query)}");
        if (state != null) query.Add($"state={state}");
        return $"{AdminPages.Root}/subscriptions" + (query.Count == 0 ? "" : "?" + string.Join("&", query));
    }

    private string Chip(string? state) => state == State
        ? "tag bg-brand px-3 py-1 text-white no-underline"
        : "tag bg-page px-3 py-1 text-ink no-underline ring-1 ring-line hover:ring-brand";
}
