@* The overview: how subscriptions, marketing and safety stand, the subscriptions that need a look, and the admins *@
<AdminLayout Admin="Admin" Title="Overview" Section="home">
    <h2 class="mb-3 text-xs font-semibold tracking-wide text-muted uppercase">Subscriptions</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <Tile Href="@($"{AdminPages.Root}/subscriptions")" Label="Subscriptions" Value="@Subscriptions.Count.ToString()"
              Hint="@($"{Counts.GetValueOrDefault("paid")} paid · {Counts.GetValueOrDefault("free")} free")" />
        <Tile Href="@($"{AdminPages.Root}/renewals?within=30")" Label="Running out in 30 days"
              Value="@Counts.GetValueOrDefault("expiring").ToString()" Tone="@(Counts.GetValueOrDefault("expiring") > 0 ? "warn" : null)"
              Hint="@($"{Counts.GetValueOrDefault("grace")} in grace")" />
        <Tile Href="@($"{AdminPages.Root}/subscriptions?state=out-of-sync")" Label="Host not in sync"
              Value="@Counts.GetValueOrDefault("out-of-sync").ToString()" Tone="@(Counts.GetValueOrDefault("out-of-sync") > 0 ? "bad" : null)"
              Hint="pending or failed" />
        <Tile Href="@($"{AdminPages.Root}/plans")" Label="Plans" Value="@Plans.Count.ToString()"
              Hint="@($"{Plans.Count(UpgradePage.IsForSale)} for sale")" />
    </div>

    <h2 class="mt-8 mb-3 text-xs font-semibold tracking-wide text-muted uppercase">Marketing</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <Tile Href="@($"{AdminPages.Root}/codes")" Label="Codes" Value="@Stats.Totals.Codes.ToString()"
              Hint="@($"{Stats.Totals.UsesLeft} signup{(Stats.Totals.UsesLeft == 1 ? "" : "s")} left")" />
        <Tile Href="@($"{AdminPages.Root}/codes/stats?days=7")" Label="Signups this week" Value="@WeekStats.Totals.Signups.ToString()"
              Hint="@($"{Stats.Totals.Signups} in all")" />
        <Tile Href="@($"{AdminPages.Root}/codes/stats?days=7")" Label="Top channel this week" Value="@(TopChannel?.Name ?? "-")"
              Hint="@(TopChannel != null ? $"{TopChannel.Signups} signups" : "no signups yet")" />
    </div>

    <h2 class="mt-8 mb-3 text-xs font-semibold tracking-wide text-muted uppercase">Safety</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <Tile Href="@($"{AdminPages.Root}/reports?days=7")" Label="Abuse reports" Value="@RecentReports.ToString()"
              Tone="@(RecentReports > 0 ? "bad" : null)" Hint="in the last 7 days" />
    </div>

    <section class="panel mt-8">
        <h2 class="panel-title">Subscriptions that need a look</h2>
        @if (NeedALook.Count == 0)
        {
            <p class="text-sm text-muted">None: every host has its subscription, and nobody is in their grace.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Identity</th><th>Plan</th><th>Until</th><th>Host</th><th>Last error</th></tr></thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var row in NeedALook.Take(20))
                        {
                            <tr>
                                <td><a class="link" href="@AdminPages.SubscriptionUrl(row.Grant.Identity)">@row.Grant.Identity</a></td>
                                <td>@row.PlanName</td>
                                <td class="text-xs whitespace-nowrap"><Until Row="row" /></td>
                                <td><SyncTag Grant="row.Grant" /></td>
                                <td class="max-w-xs text-xs break-words text-muted">@(row.Grant.Status == PlanGrantStatus.Applied ? "" : row.Grant.LastError)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel mt-6">
        <h2 class="panel-title">Admins</h2>
        <ul class="divide-y divide-line text-sm">
            @foreach (var admin in Admins)
            {
                <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                    <span class="flex items-center gap-2 font-semibold">
                        <img src="@PublicProfiles.ImageUrl(admin.Identity)" alt="" width="24" height="24" referrerpolicy="no-referrer"
                             class="size-6 rounded-full bg-line object-cover">
                        @admin.Identity
                    </span>
                    <span class="text-xs text-muted">added @AdminForm.When(admin.AddedAt)</span>
                </li>
            }
        </ul>
        <p class="mt-3 text-xs text-muted">Add and remove admins with <code class="rounded bg-page px-1">./raven.sh admins add &lt;identity&gt;</code> and <code class="rounded bg-page px-1">./raven.sh admins remove &lt;identity&gt;</code>.</p>
    </section>
</AdminLayout>

@code {
    [Parameter, EditorRequired] public AdminContext Admin { get; set; } = null!;
    [Parameter] public List<Plan> Plans { get; set; } = [];
    [Parameter] public List<SubscriptionRow> Subscriptions { get; set; } = [];
    [Parameter] public Dictionary<string, int> Counts { get; set; } = [];
    [Parameter] public InvitationCodeStats Stats { get; set; } = null!;

    /// <summary>The same, counting only the last 7 days' signups</summary>
    [Parameter] public InvitationCodeStats WeekStats { get; set; } = null!;

    [Parameter] public int RecentReports { get; set; }
    [Parameter] public List<Raven.Hosting.Admin> Admins { get; set; } = [];

    private InvitationCodeStatsLine? TopChannel =>
        WeekStats.BySource.Where(l => l.Signups > 0 && l.Name != null).MaxBy(l => l.Signups);

    // Hosts that do not have theirs, then those in their grace
    private List<SubscriptionRow> NeedALook =>
        Subscriptions.Where(r => r.Grant.Status != PlanGrantStatus.Applied)
            .Concat(Subscriptions.Where(r => r.Grant.Status == PlanGrantStatus.Applied && r.State == "grace"))
            .ToList();
}
