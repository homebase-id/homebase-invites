@* Giving an identity a plan, and the grants: filtered by identity and status, newest first, each failed or pending one
   with a retry *@
<AdminLayout Admin="Admin" Title="Grants" Section="grants">
    <form method="post" action="@($"{AdminPages.Root}/grants")" class="panel">
        <Csrf Admin="Admin" />
        <h2 class="panel-title">Give an identity a plan</h2>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
            <label class="field">
                Identity
                <input class="input" name="identity" required value="@Value("identity", Identity)" autocapitalize="none"
                       spellcheck="false" inputmode="url" placeholder="frodo.homebase.id">
            </label>
            <label class="field">
                Plan
                <select class="input" name="planId" required>
                    <option value="">Choose a plan</option>
                    @foreach (var plan in Plans)
                    {
                        <option value="@plan.Id" selected="@(Value("planId", null) == plan.Id)">@plan.Name (@plan.Storage)</option>
                    }
                </select>
            </label>
            <label class="field">
                Host
                <select class="input" name="host">
                    <option value="">Find it</option>
                    @foreach (var host in Hosts)
                    {
                        <option value="@host" selected="@(Value("host", null) == host)">@host</option>
                    }
                </select>
                <span class="field-hint">Tried first; every known host is asked anyway.</span>
            </label>
            <label class="field">
                Reference
                <input class="input" name="reference" maxlength="200" value="@Value("reference", null)" placeholder="optional">
                <span class="field-hint">Your id for it; the same one twice is one grant.</span>
            </label>
        </div>
        <p class="mt-4 text-xs text-muted">The grant keeps what the plan gives now and sets it on the identity's host straight away; if no host can take it yet, it stays pending and is retried by itself.</p>
        <div class="mt-4"><button type="submit" class="btn">Grant the plan</button></div>
    </form>

    <section class="panel mt-6">
        <form method="get" action="@($"{AdminPages.Root}/grants")" class="mb-4 flex flex-wrap items-end gap-3">
            <label class="field grow sm:grow-0">
                Identity
                <input class="input sm:w-64" name="identity" value="@Identity" autocapitalize="none" spellcheck="false" placeholder="any">
            </label>
            <label class="field">
                Status
                <select class="input" name="status">
                    <option value="">any</option>
                    @foreach (var status in PlanGrantStatus.All)
                    {
                        <option value="@status" selected="@(Status == status)">@status</option>
                    }
                </select>
            </label>
            <button type="submit" class="btn btn-secondary">Show</button>
            @if (Identity != null || Status != null)
            {
                <a class="link text-sm" href="@($"{AdminPages.Root}/grants")">Clear</a>
            }
        </form>

        @if (Grants.Count == 0)
        {
            <p class="text-sm text-muted">No grants@(Identity != null || Status != null ? " match" : " yet").</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr><th>Id</th><th>Identity</th><th>Plan</th><th>Why</th><th>Status</th><th>Host</th><th>Tries</th><th>Last error</th><th>Made</th><th></th></tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var grant in Grants)
                        {
                            <tr>
                                <td class="tabular-nums text-muted">@grant.Id</td>
                                <td><a class="link" href="@($"{AdminPages.Root}/grants?identity={Uri.EscapeDataString(grant.Identity)}")">@grant.Identity</a></td>
                                <td class="whitespace-nowrap">
                                    @grant.PlanId
                                    @if (grant.QuotaBytes is { } quota)
                                    {
                                        <span class="block text-xs text-muted">@StorageSize.Format(quota)</span>
                                    }
                                </td>
                                <td class="text-xs">
                                    @grant.Source
                                    @if (grant.PriceAmountCents is { } cents && grant.PriceMonths is { } months)
                                    {
                                        <span class="block text-muted">@(new PlanPrice(months, cents).Text)</span>
                                    }
                                    <span class="block max-w-40 truncate text-muted" title="@grant.Reference">@grant.Reference</span>
                                </td>
                                <td><StatusTag Text="@grant.Status" /></td>
                                <td class="text-xs">@(grant.Host ?? grant.HostHint)</td>
                                <td class="tabular-nums">@grant.Attempts</td>
                                <td class="max-w-xs text-xs break-words text-muted">@grant.LastError</td>
                                <td class="text-xs whitespace-nowrap text-muted">@AdminForm.When(grant.CreatedAt)</td>
                                <td>
                                    @if (grant.Status != PlanGrantStatus.Applied)
                                    {
                                        <form method="post" action="@($"{AdminPages.Root}/grants/{grant.Id}/retry")">
                                            <Csrf Admin="Admin" />
                                            <input type="hidden" name="back" value="@Back">
                                            <button type="submit" class="btn btn-small btn-secondary">Retry</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</AdminLayout>

@code {
    [Parameter, EditorRequired] public AdminContext Admin { get; set; } = null!;
    [Parameter] public List<PlanGrant> Grants { get; set; } = [];
    [Parameter] public List<Plan> Plans { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Hosts { get; set; } = [];

    /// <summary>The filters: only this identity's grants, only those in this status</summary>
    [Parameter] public string? Identity { get; set; }
    [Parameter] public string? Status { get; set; }

    /// <summary>A grant form that was refused, shown as it was sent</summary>
    [Parameter] public IFormCollection? Form { get; set; }

    private string Value(string name, string? fallback) => AdminForm.Value(Form, name, fallback);

    // This page with its filters, to come back to after a retry
    private string Back
    {
        get
        {
            var query = new List<string>();
            if (Identity != null) query.Add($"identity={Uri.EscapeDataString(Identity)}");
            if (Status != null) query.Add($"status={Uri.EscapeDataString(Status)}");
            return $"{AdminPages.Root}/grants" + (query.Count == 0 ? "" : "?" + string.Join("&", query));
        }
    }
}
